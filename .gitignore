/target

# Built binaries and packaged releases: these belong on GitHub releases, not in git.
*.exe
*.tar.gz
*.zip
*.sha256
/rtp-audio-*/

# Maintainer-only notes, kept offline.
/docs/releasing.md
/notes-*.md

# Local audit reports and the fixes log: not part of the repository.
/progress/

# The window's page: npm installs and builds these (src/gui/README.md), Tauri generates gen/.
/src/gui/web/node_modules/
/src/gui/web/dist/
/src/gui/web/test-results/
/src/gui/web/*.png
/src/gui/gen/
