{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RTP Audio Studio",
  "version": "0.1.0",
  "identifier": "com.rtpaudio.studio",
  "build": {
    "frontendDist": "web/dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "title": "RTP Audio Studio",
        "width": 1400,
        "height": 750,
        "resizable": false,
        "fullscreen": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
